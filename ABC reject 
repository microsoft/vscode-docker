          "/autoscan-*.log",
          "/aclocal.m4",
          "/compile",
          "/config.cache",
          "/config.guess",
          "/config.h.in",
          "/config.log",
          "/config.status",
          "/config.sub",
          "/configure",
          "/configure.scan",
          "/depcomp",
          "/install-sh",
          "/missing",
          "/stamp-h1",

